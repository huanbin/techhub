---
import BaseLayout  from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

// 指定要静态生成的动态路由
export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

// 接收 getStaticPaths 传入的文章
const { post } = Astro.props;

// 将 Markdown 正文转换为可渲染组件
const { Content, headings } = await render(post);
// 生成文章目录
const toc = headings.filter(
  (heading) => heading.depth >= 2
);
---

<BaseLayout>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>

      <p class="description">
        {post.data.description}
      </p>

      <time datetime={post.data.pubDate.toISOString()}>
        发布于：
        {post.data.pubDate.toLocaleDateString("zh-CN")}
      </time>
    </header>

    <hr />

    <div class="post-content">
        {
            toc.length > 0 && (
                <nav class="toc">
                <h2>文章目录</h2>

                <ul>
                    {
                    toc.map((heading) => (
                        <li style={`padding-left: ${(heading.depth - 2) * 16}px`}>
                        <a href={`#${heading.slug}`}>
                            {heading.text}
                        </a>
                        </li>
                    ))
                    }
                </ul>
                </nav>
        )}
        <Content />
    </div>
  </article>
</BaseLayout>
<!-- 组件作用域样式，所以用global让style作用到markdown生成的html（不在Astro模板的） -->
<style>
.toc {
    margin: 30px 0;
    padding: 20px;
    background: #f8fafc;
    border-radius: 8px;
}

.toc ul {
    padding: 0;
    list-style: none;
}

.toc li {
    margin: 8px 0;
}

.toc a {
    color: #475569;
    text-decoration: none;
}

.toc a:hover {
    color: #2563eb;
}

.post {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 20px;
}

.post-header {
    margin-bottom: 30px;
}

.post-header h1 {
    font-size: 36px;
    line-height: 1.4;
}

.description {
    color: #6b7280;
    font-size: 18px;
}

.post-header time {
    color: #9ca3af;
    font-size: 14px;
}

.post-content {
    line-height: 1.9;
    overflow-wrap: anywhere;
}
/* global：让style作用到markdown生成的html元素上 */
.post-content :global(h2) {
    margin-top: 36px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e5e7eb;
}

.post-content :global(h3) {
    margin-top: 28px;
}

.post-content :global(pre) {
    padding: 16px;
    overflow-x: auto;
    border-radius: 8px;
    background: #f3f4f6;
}

.post-content :global(code) {
    font-family: monospace;
}

.post-content :global(img) {
    max-width: 100%;
    height: auto;
}
</style>