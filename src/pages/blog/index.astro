---
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = [
  {
    slug: "astro",
    title: "Astro 入门",
    description: "学习 Astro 的核心架构",
  },
  {
    slug: "react",
    title: "React Islands",
    description: "理解 Astro 中的 React",
  },
  {
    slug: "python",
    title: "Python 网络编程",
    description: "使用 Python 学习网络编程",
  },
];
---

<BaseLayout>
  <h1>技术文章</h1>

  {
    articles.map((article) => (
      <article>
        <h2>
          <a href={`/blog/${article.slug}`}>
            {article.title}
          </a>
        </h2>

        <p>{article.description}</p>
      </article>
    ))
  }
</BaseLayout>