---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
//
const posts = await getCollection("blog");
---

<BaseLayout>
  <h1>技术文章</h1>

  {
    posts.map((post) => (
      <article>
        <h2>
          <a href={`/blog/${post.id}`}>
            {post.data.title}
          </a>
        </h2>

        <p>{post.data.description}</p>

        <time>
          {post.data.pubDate.toLocaleDateString("zh-CN")}
        </time>
      </article>
    ))
  }
</BaseLayout>