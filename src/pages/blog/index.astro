---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// 读取所有文章
const posts = await getCollection("blog",({ data }) => data.draft !== true);

// 按发布日期倒序排列
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <div class="blog-page">
    <header class="page-header">
      <h1>技术文章</h1>
      <p>记录技术学习、实践与思考。</p>
    </header>

  <div class="article-list">
      {
        sortedPosts.map((post) => (
          <article class="article-card">
            <div class="meta">
              <span>{post.data.category}</span>

              <time>
                {post.data.pubDate.toLocaleDateString("zh-CN")}
              </time>
            </div>

            <h2>
              <a href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h2>

            <p>{post.data.description}</p>

            <div class="tags">
              {
                post.data.tags.map((tag) => (
                  <span>#{tag}</span>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 20px;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .article-list {
    display: grid;
    gap: 20px;
  }

  .article-card {
    padding: 20px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
  }

  .article-card h2 {
    margin: 10px 0;
  }

  .article-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    color: #6b7280;
    font-size: 14px;
  }

  .article-card p {
    color: #6b7280;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    color: #2563eb;
    font-size: 14px;
  }
</style>