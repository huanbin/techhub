---
import BaseLayout  from "../layouts/BaseLayout.astro";

const articles = [
  {
    title: "Astro 入门",
    description: "学习 Astro 的基础架构",
  },
  {
    title: "React Islands",
    description: "理解 Astro 中的 React",
  },
  {
    title: "Astro Content Collections",
    description: "构建技术博客内容系统",
  },
  {
	title: "Python 网络编程",
	description: "使用 Python 学习 TCP/IP",
 }
];
---

<BaseLayout>
    <h1>TechHub</h1>

    <section>
		{
			articles.map((article)=>
				<article>
					<h2>{article.title}</h2>
					<p>{article.description}</p>
				</article>
			)
		}
	</section>
</BaseLayout>